		<Definition xsi:type="MyObjectBuilder_ButtonPanelDefinition">
			<Id>
				<TypeId>ButtonPanel</TypeId>
				<SubtypeId>NotificationBlock</SubtypeId>
			</Id>
			<DisplayName>Notification Block</DisplayName>
			<Description>For receving notifications about Anomalies,</Description>
			<Icon>Textures\GUI\Icons\Cubes\InteriorButtonPanel.dds</Icon>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="1" y="1" z="1" />
			<ModelOffset x="0" y="0" z="0" />
			<Model>Models\Cubes\large\NotificationBlock.mwm</Model>
			<Components>
				<Component Subtype="InteriorPlate" Count="20" />
				<Component Subtype="Construction" Count="10" />
				<Component Subtype="Computer" Count="20" />
				<Component Subtype="Display" Count="10" />
				<Component Subtype="Construction" Count="10" />
			</Components>
			<CriticalComponent Subtype="Display" Index="0" />
			<MountPoints>
				<MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
				<MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
				<MountPoint Side="Right" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="1" />
				<MountPoint Side="Front" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="1" />
				<MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
				<MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Cubes\large\NotificationBlock_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\Cubes\large\NotificationBlock_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\NotificationBlock_BS3.mwm"/>
			</BuildProgressModels>
			<BlockPairName>NotificationBlock</BlockPairName>
			<ScreenAreas>
				<ScreenArea Name="CockpitScreen_01" DisplayName="DisplayName_Screen_Large" TextureResolution="256" ScreenWidth="4" ScreenHeight="3" />

				<!--ScreenArea Name="CockpitScreen_01" DisplayName="Anomalies" TextureResolution="512" ScreenWidth="4" ScreenHeight="3" /-->
				<ScreenArea Name="CockpitScreen_02" DisplayName="DisplayName_Screen_Left" TextureResolution="256" ScreenWidth="4" ScreenHeight="3" />
				<ScreenArea Name="CockpitScreen_03" DisplayName="DisplayName_Screen_Right" TextureResolution="256" ScreenWidth="4" ScreenHeight="3" />
			</ScreenAreas>
			<EdgeType>Light</EdgeType>
			<MirroringY>X</MirroringY>
			<MirroringX>Y</MirroringX>
			<BuildTimeSeconds>18</BuildTimeSeconds>
			<ResourceSinkGroup>Utility</ResourceSinkGroup>
			<ButtonCount>0</ButtonCount>
			<ButtonSymbols>
				<string>Textures\GUI\Icons\buttons\OneButton.dds</string>
			</ButtonSymbols>
			<UnassignedButtonColor>
				<X>0.34</X>
				<Y>0.34</Y>
				<Z>0.34</Z>
				<W>0</W>
			</UnassignedButtonColor>
			<ButtonColors>
				<Vector4>
					<X>1</X>
					<Y>1</Y>
					<Z>0.3</Z>
					<W>1</W>
				</Vector4>
				<Vector4>
					<X>1</X>
					<Y>1</Y>
					<Z>0.3</Z>
					<W>1</W>
				</Vector4>
				<Vector4>
					<X>1</X>
					<Y>1</Y>
					<Z>0.3</Z>
					<W>1</W>
				</Vector4>
			</ButtonColors>
			<DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
			<DamagedSound>ParticleElectrical</DamagedSound>
			<DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>75</PCU>
			<IsAirTight>true</IsAirTight>
			<DLC>DecorativeBlocks3</DLC>
		</Definition>
		
	</CubeBlocks>
</Definitions>